# Copy this file to C:\apps\submit-system\shared\.env on the IIS server.
# Replace every replace-* value before starting the API.
APP_ENV=production
DATABASE_URL=mssql+pyodbc://submit_app:replace-url-encoded-password@replace-sql-server/submission?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
STORAGE_ROOT=C:/apps/submit-system/shared/storage

# The React application and API are served from the same IIS origin.
CORS_ORIGINS=http://171.244.37.116

AUTH_MODE=api_key
API_KEYS_JSON={"replace-with-a-long-random-api-key":"Salamanders"}
PERMISSION_MODE=owner_only

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
MAX_REQUEST_BYTES=12582912
MAX_ZIP_BYTES=5242880
MAX_ZIP_ENTRIES=500
MAX_ZIP_EXTRACTED_BYTES=20971520
MAX_IMAGE_BYTES=5242880
RESULT_RATE_LIMIT_PER_MINUTE=120
